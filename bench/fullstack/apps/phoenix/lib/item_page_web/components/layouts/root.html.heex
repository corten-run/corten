<!DOCTYPE html>
<html lang={assigns[:locale] || "en"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default={if assigns[:status] == 404, do: "Not found | Card Market", else: "Card Market"}>{assigns[:page_title]}</.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/css/style.css"} />
    <link phx-track-static rel="stylesheet" href={~p"/css/components.css"} />
    <link :if={assigns[:catalog_page]} phx-track-static rel="stylesheet" href={~p"/css/catalog.css"} />
    <link :if={assigns[:marketplace_page]} phx-track-static rel="stylesheet" href={~p"/css/marketplace.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body>
    <header class="site-header__bar"><.link navigate={~p"/"}>Card Market</.link></header>
    <main>{@inner_content}</main>
  </body>
</html>
