<% item = @item %><% content_for :title, "#{item["title"]} | Card Market" %>
<article>
<div class="item-detail__top"><div class="item-detail__intro"><nav class="item-detail__crumbs"><% item["categories"].each do |c| %><a href="/categories/<%= c["slug"] %>"><%= c["name"] %></a><% end %></nav>
<h1><%= item["title"] %></h1>
<% if item["subtitle"] %><p class="item-detail__subtitle"><%= item["subtitle"] %></p><% end %>
<ul class="item-detail__chips"><% item["badges"].each do |b| %><li><%= b %></li><% end %></ul></div>
<% if item["images"].any? %><div class="item-detail__gallery"><% item["images"].each_with_index do |url, i| %><div class="item-detail__image" role="img" aria-label="<%= item["title"] %> image <%= i + 1 %>" data-src="<%= url %>"></div><% end %></div><% end %>
<section class="item-detail__panel item-detail__summary gap-3 sm:gap-5"><% if (s = item["summary"]) %><span><strong><%= s["lowest"] || "—" %></strong> lowest</span><span><%= number_with_delimiter(s["count"]) %> <%= s["count"] == 1 ? "listing" : "listings" %></span><span><%= number_with_delimiter(s["quantity"]) %> available</span><% else %><span>No listings yet</span><% end %></section></div>
<section class="item-detail__panel" data-controller="sort">
<h2>Listings</h2>
<button type="button" data-action="sort#toggle"><span data-sort-target="ascending">Price: low to high</span><span data-sort-target="descending" hidden>Price: high to low</span></button>
<table><thead><tr><th>Seller</th><th>Condition</th><th>Ships from</th><th>Qty</th><th>Price</th></tr></thead>
<tbody data-sort-target="rows"><% item["listings"].sort_by.with_index { |l, i| [l["price_value"], i] }.each do |l| %><tr><td><%= l["seller"] %><% if l["rating"] %> · <%= l["rating"] %> ★ (<%= l["reviews"] %>)<% end %></td><td><%= l["condition"] %></td><td><%= l["ships_from"] %></td><td><%= l["quantity"] %></td><td class="price__amount"><%= l["price"] %></td></tr><% end %></tbody></table>
</section>
<section class="item-detail__panel"><turbo-frame id="offers">
<h2>Offers</h2>
<table><thead><tr><th>Buyer</th><th>Condition</th><th>Qty</th><th>Price</th></tr></thead>
<tbody><% (@all_offers ? item["offers"] : item["offers"].first(5)).each do |o| %><tr><td><%= o["buyer"] %></td><td><%= o["condition"] %></td><td><%= o["quantity"] %></td><td class="price__amount"><%= o["price"] %></td></tr><% end %></tbody></table>
<% if item["offers"].size > 5 && !@all_offers %><form method="get" action="/items/<%= item["id"] %>"><button name="offers" value="all">Show all <%= item["offers"].size %> offers</button></form><% end %>
</turbo-frame></section>
<section class="item-detail__panel">
<h2>Price alert</h2>
<div class="alert-form__form"><%= form_with url: "/items/#{item["id"]}", method: :post do %>
<input type="hidden" name="item_id" value="<%= item["id"] %>"><input type="hidden" name="title" value="<%= item["title"] %>">
<label>Email<input type="email" name="email" required></label>
<label>Alert me below<input type="text" name="target_price" inputmode="decimal" required></label>
<button type="submit">Set alert</button><% end %></div>
<%= render "items/message", message: @message %>
</section>
<section class="item-detail__panel">
<h2>Details</h2>
<p><%= item["description"] %></p>
<dl><% item["fields"].each do |f| %><dt><%= f["name"] %></dt><dd><%= f["value"] %></dd><% end %></dl>
<% if item["tags"].any? %><ul class="item-detail__chips"><% item["tags"].each do |t| %><li><%= t %></li><% end %></ul><% end %>
</section>
<% if item["contents"].any? %><section class="item-detail__panel"><h2>Contents</h2><ul><% item["contents"].each do |c| %><li><a href="/items/<%= c["item_id"] %>"><%= c["title"] %></a> × <%= c["quantity"] %></li><% end %></ul></section><% end %>
<% if item["included_in"].any? %><section class="item-detail__panel"><h2>Included in</h2><ul><% item["included_in"].each do |c| %><li><a href="/items/<%= c["item_id"] %>"><%= c["title"] %></a> × <%= c["quantity"] %></li><% end %></ul></section><% end %>
</article>
