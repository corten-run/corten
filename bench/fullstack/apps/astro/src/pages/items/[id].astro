---
import { actions } from "astro:actions";
import Base from "../../layouts/Base.astro";
import { fetchItem } from "../../lib/api";
import { counted, sortListings } from "../../lib/view-model";

const item = await fetchItem(Astro.params.id ?? "");
if (!item) Astro.response.status = 404;
// Without JavaScript the form posts here and the action's answer comes back in the page.
const message = Astro.getActionResult(actions.alert)?.data?.message ?? "";
const allOffers = Astro.url.searchParams.get("offers") === "all";
const listings = item ? sortListings(item.listings, false) : [];
const offers = item ? (allOffers ? item.offers : item.offers.slice(0, 5)) : [];
---
<Base title={item ? `${item.title} | Card Market` : "Not found | Card Market"}>
  {!item ? (
  <>
    <h1>Not found</h1>
    <p>There is no card at this address.</p>
    <p><a href="/">Go to popular items</a></p>
  </>
  ) : (
  <article>
    <div class="item-detail__top">
      <div class="item-detail__intro">
        <nav class="item-detail__crumbs">{item.categories.map((c) => <a href={`/categories/${c.slug}`}>{c.name}</a>)}</nav>
        <h1>{item.title}</h1>
        {item.subtitle && <p class="item-detail__subtitle">{item.subtitle}</p>}
        <ul class="item-detail__chips">{item.badges.map((b) => <li>{b}</li>)}</ul>
      </div>
      {item.images.length > 0 && <div class="item-detail__gallery">{item.images.map((url, i) => <div class="item-detail__image" role="img" aria-label={`${item.title} image ${i + 1}`} data-src={url}></div>)}</div>}
      <section class="item-detail__panel item-detail__summary gap-3 sm:gap-5">
        {item.summary ? (
          <><span><strong>{item.summary.lowest ?? "—"}</strong> lowest</span> <span>{counted(item.summary.count, "listing", "listings")}</span> <span>{counted(item.summary.quantity, "available", "available")}</span></>
        ) : <span>No listings yet</span>}
      </section>
    </div>
    <section class="item-detail__panel">
      <h2>Listings</h2>
      <button type="button" data-sort><span>Price: low to high</span><span hidden>Price: high to low</span></button>
      <table>
        <thead><tr><th>Seller</th><th>Condition</th><th>Ships from</th><th>Qty</th><th>Price</th></tr></thead>
        <tbody>{listings.map((l) => <tr><td>{l.seller + (l.rating ? ` · ${l.rating} ★ (${l.reviews})` : "")}</td><td>{l.condition}</td><td>{l.ships_from}</td><td>{l.quantity}</td><td class="price__amount">{l.price}</td></tr>)}</tbody>
      </table>
    </section>
    <section class="item-detail__panel" data-offers>
      <h2>Offers</h2>
      <table>
        <thead><tr><th>Buyer</th><th>Condition</th><th>Qty</th><th>Price</th></tr></thead>
        <tbody>{offers.map((o) => <tr><td>{o.buyer}</td><td>{o.condition}</td><td>{o.quantity}</td><td class="price__amount">{o.price}</td></tr>)}</tbody>
      </table>
      {item.offers.length > 5 && !allOffers && <form method="get" action={`/items/${item.id}`} data-more data-astro-reload><button name="offers" value="all">{`Show all ${item.offers.length} offers`}</button></form>}
    </section>
    <section class="item-detail__panel">
      <h2>Price alert</h2>
      <div class="alert-form__form">
        <form method="POST" action={actions.alert} data-alert>
          <input type="hidden" name="item_id" value={item.id} />
          <input type="hidden" name="title" value={item.title} />
          <label>Email<input type="email" name="email" required /></label>
          <label>Alert me below<input type="text" name="target_price" inputmode="decimal" required /></label>
          <button type="submit">Set alert</button>
        </form>
      </div>
      <p class="alert-form__message" id="alert-message" aria-live="polite">{message}</p>
    </section>
    <section class="item-detail__panel">
      <h2>Details</h2>
      <p>{item.description}</p>
      <dl>{item.fields.map((f) => <><dt>{f.name}</dt><dd>{f.value}</dd></>)}</dl>
      {item.tags.length > 0 && <ul class="item-detail__chips">{item.tags.map((t) => <li>{t}</li>)}</ul>}
    </section>
    {item.contents.length > 0 && <section class="item-detail__panel"><h2>Contents</h2><ul>{item.contents.map((c) => <li><a href={`/items/${c.item_id}`}>{c.title}</a>{` × ${c.quantity}`}</li>)}</ul></section>}
    {item.included_in.length > 0 && <section class="item-detail__panel"><h2>Included in</h2><ul>{item.included_in.map((c) => <li><a href={`/items/${c.item_id}`}>{c.title}</a>{` × ${c.quantity}`}</li>)}</ul></section>}
  </article>
  )}
</Base>

<script>
  import { actions } from "astro:actions";

  // Module scripts run once; the client router swaps pages, so listen on the document.
  document.addEventListener("click", async (event) => {
    const target = event.target as HTMLElement;
    const sort = target.closest<HTMLButtonElement>("button[data-sort]");
    if (sort) {
      // The server renders the listings cheapest first; "high to low" is the same rows reversed,
      // which is the order sortListings gives.
      const rows = sort.parentElement!.querySelector("tbody")!;
      rows.append(...[...rows.rows].reverse());
      for (const label of sort.children) (label as HTMLElement).hidden = !(label as HTMLElement).hidden;
    }
  });

  document.addEventListener("submit", async (event) => {
    const form = event.target as HTMLFormElement;
    if (form.hasAttribute("data-more")) {
      // "Show all": the page with every offer, as the form would load it, and its offers swapped in.
      // (data-astro-reload keeps the client router from taking the submit as a navigation.)
      event.preventDefault();
      const url = new URL(form.action);
      url.search = new URLSearchParams(new FormData(form, event.submitter) as unknown as Record<string, string>).toString();
      const page = new DOMParser().parseFromString(await (await fetch(url)).text(), "text/html");
      form.closest("[data-offers]")!.replaceWith(page.querySelector("[data-offers]")!);
      return;
    }
    if (!form.hasAttribute("data-alert")) return;
    event.preventDefault();
    const { data, error } = await actions.alert(new FormData(form));
    document.getElementById("alert-message")!.textContent = data?.message ?? error?.message ?? "";
  });
</script>
