<%inc #include "marketplace.h"
#include "model.h" %>
<%c++ const auto &view = *@@.get<marketplace::ViewPtr>("marketplace"); %>
<!doctype html>
<html lang="{% esc(view.locale) %}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% esc((*view.record)["title"].asString()) %} | Card Market</title>
<link rel="stylesheet" href="/style.css">
<link rel="stylesheet" href="/components.css">
<link rel="stylesheet" href="/marketplace.css">
<script src="/htmx.min.js" defer></script>
<script src="/item.js" defer></script>
</head>
<body hx-boost="false">
<header class="site-header__bar"><a href="/">Card Market</a></header>
<main>[[]]</main>
</body>
</html>
