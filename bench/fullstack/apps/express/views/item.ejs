<%- include("head", { title: `${item.title} | Card Market` }) %><article>
<div class="item-detail__top"><div class="item-detail__intro"><nav class="item-detail__crumbs"><% for (const c of item.categories) { %><a href="/categories/<%= c.slug %>"><%= c.name %></a><% } %></nav>
<h1><%= item.title %></h1>
<% if (item.subtitle) { %><p class="item-detail__subtitle"><%= item.subtitle %></p><% } %>
<ul class="item-detail__chips"><% for (const b of item.badges) { %><li><%= b %></li><% } %></ul></div>
<% if (item.images.length) { %><div class="item-detail__gallery"><% item.images.forEach((url, i) => { %><div class="item-detail__image" role="img" aria-label="<%= item.title %> image <%= i + 1 %>" data-src="<%= url %>"></div><% }) %></div><% } %>
<section class="item-detail__panel item-detail__summary gap-3 sm:gap-5"><% if (item.summary) { %><span><strong><%= item.summary.lowest ?? "\u2014" %></strong> lowest</span><span><%= grouped(item.summary.count) %> listing<%= item.summary.count === 1 ? "" : "s" %></span><span><%= grouped(item.summary.quantity) %> available</span><% } else { %><span>No listings yet</span><% } %></section></div>
<section class="item-detail__panel">
<h2>Listings</h2>
<button type="button" data-sort><span>Price: low to high</span><span hidden>Price: high to low</span></button>
<table><thead><tr><th>Seller</th><th>Condition</th><th>Ships from</th><th>Qty</th><th>Price</th></tr></thead>
<tbody><% for (const l of listings) { %><tr><td><%= l.seller %><% if (l.rating) { %> · <%= l.rating %> ★ (<%= l.reviews %>)<% } %></td><td><%= l.condition %></td><td><%= l.ships_from %></td><td><%= l.quantity %></td><td class="price__amount"><%= l.price %></td></tr><% } %></tbody></table>
</section>
<section class="item-detail__panel" id="offers">
<h2>Offers</h2>
<table><thead><tr><th>Buyer</th><th>Condition</th><th>Qty</th><th>Price</th></tr></thead>
<tbody><% for (const o of offers) { %><tr><td><%= o.buyer %></td><td><%= o.condition %></td><td><%= o.quantity %></td><td class="price__amount"><%= o.price %></td></tr><% } %></tbody></table>
<% if (moreOffers) { %><form method="get" action="/items/<%= item.id %>" hx-get="/items/<%= item.id %>" hx-select="#offers" hx-target="#offers" hx-swap="outerHTML"><button name="offers" value="all">Show all <%= item.offers.length %> offers</button></form><% } %>
</section>
<section class="item-detail__panel">
<h2>Price alert</h2>
<div class="alert-form__form"><form method="post" action="/items/<%= item.id %>" hx-post="/items/<%= item.id %>" hx-target="#alert-message" hx-swap="outerHTML">
<input type="hidden" name="item_id" value="<%= item.id %>"><input type="hidden" name="title" value="<%= item.title %>">
<label>Email<input type="email" name="email" required></label>
<label>Alert me below<input type="text" name="target_price" inputmode="decimal" required></label>
<button type="submit">Set alert</button></form></div>
<%- include("alert-message", { message }) %>
</section>
<section class="item-detail__panel">
<h2>Details</h2>
<p><%= item.description %></p>
<dl><% for (const f of item.fields) { %><dt><%= f.name %></dt><dd><%= f.value %></dd><% } %></dl>
<% if (item.tags.length) { %><ul class="item-detail__chips"><% for (const t of item.tags) { %><li><%= t %></li><% } %></ul><% } %>
</section>
<% if (item.contents.length) { %><section class="item-detail__panel"><h2>Contents</h2><ul><% for (const c of item.contents) { %><li><a href="/items/<%= c.item_id %>"><%= c.title %></a> × <%= c.quantity %></li><% } %></ul></section><% } %>
<% if (item.included_in.length) { %><section class="item-detail__panel"><h2>Included in</h2><ul><% for (const c of item.included_in) { %><li><a href="/items/<%= c.item_id %>"><%= c.title %></a> × <%= c.quantity %></li><% } %></ul></section><% } %>
</article><%- include("foot") %>
