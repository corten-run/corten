# A separate image keeps the historical workload's build origin unchanged.
FROM node:26.13.1-bookworm-slim@sha256:5df79989ed685e09f0a98019db4cebfb22fb9df1a53c0161664a011f7ff6b0f1 AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
ENV BENCHMARK_ORIGIN=http://127.0.0.1:8080
RUN npm run build && npm prune --omit=dev

FROM node:26.13.1-bookworm-slim@sha256:5df79989ed685e09f0a98019db4cebfb22fb9df1a53c0161664a011f7ff6b0f1
WORKDIR /app
ENV NODE_ENV=production HOST=0.0.0.0 PORT=8080 ORIGIN=http://127.0.0.1:8080
COPY --from=build /app/package.json ./
COPY --from=build /app/build ./build
EXPOSE 8080
CMD ["node", "build"]
