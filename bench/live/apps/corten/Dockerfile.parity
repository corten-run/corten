# syntax=docker/dockerfile:1
FROM rust:1.100.0-trixie@sha256:e19840879045c951c905d0eaa9887f3439c62000e429963371b376bac8d38c31 AS build
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY bench/live/apps/corten ./bench/live/apps/corten
ENV CARGO_HOME=/var/cache/cargo
RUN --mount=type=cache,target=/var/cache/cargo \
    --mount=type=cache,id=bench-live-corten-parity.target,target=/src/bench/live/apps/corten/target,sharing=locked \
    find crates bench/live/apps/corten -name target -prune -o -type f -exec touch {} + \
    && cd bench/live/apps/corten && cargo build --locked --release \
    && mkdir -p /out && cp target/release/live-corten /out/server
FROM debian:trixie-20261104-slim@sha256:a72b4433de1cf7d6bae0c4cee74d0547f58601a643b3375f070c51600d63b6b2
COPY --from=build /out/server /app/server
ENV HOST=0.0.0.0 PORT=8080 LIVE_PARITY=1
EXPOSE 8080
CMD ["/app/server"]
