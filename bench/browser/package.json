{
  "//": "Browser benchmark of Corten's views against plain JavaScript, Solid, Svelte, Vue, React and Remix 3. Bench-only dependencies; the framework does not depend on any of them.",
  "name": "corten-browser-bench",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "serve": "node serve.mjs",
    "bench": "node run.mjs"
  },
  "overrides": {
    "@remix-run/test": {
      "esbuild": "$esbuild"
    }
  },
  "devDependencies": {
    "@babel/core": "7.29.13",
    "babel-preset-solid": "1.9.19",
    "esbuild": "0.28.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remix": "3.2.0",
    "solid-js": "1.9.19",
    "svelte": "5.57.3",
    "vue": "3.5.45"
  }
}
