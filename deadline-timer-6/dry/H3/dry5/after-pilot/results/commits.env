# commits.env: the Corten commits this kit builds (corten-run/corten), each from src-<side>/ (a
# git archive of crates examples Cargo.toml Cargo.lock .cargo at that commit) and
# src-<side>.commit, which build.sh and run.sh require to be the commit named here.
#   BASE  main, the commit the pull request's branch last merged. The pilot reads it alone:
#         base against base, each side its own placements. It is the base of both parts.
#   HEAD  the pull request's head when the plan was declared. The pilot builds and turns no
#         binary of it; a head with other code is stated in the pull request before the gated
#         run's first turn, and this file is declared again with it then.
BASE=26ab0e37f753ffc4f9418bc28ad7825a924d08e1
HEAD=f8934bc998a7609728826c106cfc57fdd1aef3dd
