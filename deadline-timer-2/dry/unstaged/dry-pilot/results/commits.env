# commits.env: the Corten commits this kit builds (corten-run/corten), each from src-<side>/ (a
# git archive of crates examples Cargo.toml Cargo.lock .cargo at that commit) and
# src-<side>.commit.
#   BASE  main, the commit the pull request's branch last merged. The pilot reads it alone:
#         base against base, each side its own placements.
#   HEAD  the pull request's head when the plan was published. The pilot builds and turns no
#         binary of it; the gated run's head is stated in the pull request's description before
#         that run's first turn, and this file is declared again with it then.
BASE=81e77162a666a8be1360a6f4705b9f54feb7d511
HEAD=098f56243e4445777e97cde99ff738099c13cc33
