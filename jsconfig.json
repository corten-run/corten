{
  "//": "Type-checks the runtime and the scripts next to components without a build step: npm run check",
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "allowUnreachableCode": false,
    "noUncheckedSideEffectImports": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": [],
    "paths": { "corten": ["./crates/corten/js/corten.js"], "corten/keys": ["./crates/corten/js/keys.js"] }
  },
  "include": [
    "crates/corten/js/*.js",
    "crates/corten/js/*.d.ts",
    "crates/corten/src/**/*.js",
    "crates/corten/src/**/*.d.ts",
    "crates/corten-ui/src/*.js",
    "examples/*/src/**/*.js",
    "examples/*/static/**/*.js",
    "examples/*/types/*.d.ts",
    "crates/corten-cli/template/src/**/*.js",
    "scripts/typecheck-fixture.js"
  ]
}
