+/// corten-run/corten#1923 layout probe, not in the repository: 40 bytes of NOPs and a return,
+/// never called. `Router::new` takes its address once at startup so the linker keeps it, and
+/// the code placed after it moves; no request runs it or anything it changes.
+#[inline(never)]
+pub(crate) fn layout_pad() {
+    // SAFETY: never executed; if it were, it would run NOPs and return.
+    unsafe { core::arch::asm!(".skip 40, 0x90", options(nomem, nostack, preserves_flags)) }
+}
