+    /// corten-run/corten#1824 measurement variant, not a candidate: a copy of `body` of its own
+    /// length, in the store's chunk while the store has room (a new chunk of [`CHUNK`] bytes,
+    /// made resident at once by [`populate`], when the last one has no room for it), so a kept
+    /// body is written into memory touched before; as main does otherwise. A chunk is given
+    /// back only when every body copied into it is dropped.
+    #[cfg(target_os = "linux")]
+    fn copy_in(&self, body: &[u8]) -> Bytes {
+        if body.len() > CHUNK / 8 || self.full() {
+            return Bytes::copy_from_slice(body);
+        }
+        let mut chunk = self.chunk.lock().unwrap_or_else(PoisonError::into_inner);
+        if chunk.capacity() - chunk.len() < body.len() {
+            *chunk = bytes::BytesMut::with_capacity(CHUNK);
+            populate(&mut chunk);
+        }
+        chunk.extend_from_slice(body);
+        chunk.split().freeze()
+    }
