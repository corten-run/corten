+/// corten-run/corten#1824 measurement variant, not in the repository and not a candidate: the
+/// size of the store's chunks for kept bodies ([`Store::copy_in`]).
+#[cfg(target_os = "linux")]
+const CHUNK: usize = 2 << 20;
+
+/// corten-run/corten#1824 measurement variant, not a candidate. Makes `chunk`'s spare room
+/// resident in one call (`madvise(MADV_POPULATE_WRITE)`, Linux 5.14 and later; where that is
+/// refused, each page is written, one fault a page as before). It logs which of the two ways it
+/// took, once (`POPULATE`).
+#[cfg(target_os = "linux")]
+fn populate(chunk: &mut bytes::BytesMut) {
+    const MADV_POPULATE_WRITE: i32 = 23;
+    const PAGE: usize = 4096;
+    extern "C" {
+        fn madvise(addr: *mut std::ffi::c_void, len: usize, advice: i32) -> i32;
+    }
+    static SAID: std::sync::Once = std::sync::Once::new();
+    let spare = chunk.spare_capacity_mut();
+    let start = spare.as_mut_ptr() as usize;
+    let first = start.next_multiple_of(PAGE);
+    let end = (start + spare.len()) / PAGE * PAGE;
+    if end <= first {
+        return;
+    }
+    // SAFETY: `first..end` is within `spare`, a live allocation `chunk` owns, written only by the
+    // kernel or here, one byte a page, as uninitialized room `chunk` does not read.
+    unsafe {
+        let populated = madvise(first as *mut std::ffi::c_void, end - first, MADV_POPULATE_WRITE) == 0;
+        if !populated {
+            for page in (first..end).step_by(PAGE) {
+                (page as *mut u8).write_volatile(0);
+            }
+        }
+        SAID.call_once(|| eprintln!("POPULATE {}", if populated { "madvise" } else { "written" }));
+    }
+}
