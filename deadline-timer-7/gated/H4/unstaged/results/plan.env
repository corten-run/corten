# plan.env: the numbers of the part plan.md declares, read by plan.sh (build.sh, verify.sh,
# run.sh), schedule.mjs and report.mjs. Written before any binary was built or measured.
# padlists.mjs writes and checks the pad lists (pads.mjs's, for each workload's own K).
#   KIT       this kit's name, written into every placement's record; report.mjs refuses others
#   PART      pilot: for each workload an A/A of the base against itself, read only for the spread
#             of its placement medians (comparison pilot-<w>: base-p<p_i> against base-p<q_i>)
#             gated: aa-<w> (base-p<p_i> against base-p<q_i>) and change-<w> (base-p<p_i> against
#             head-p<p_i>), declared with its K's after the pilot is read
#   K_<W>     each workload's placements, i = 1..K: PLAIN, WAIT, CLOSE, UNSTAGED, AFTER, BESIDE,
#             BESIDEMT
#   R         recorded pairs per placement, after one unrecorded pair
#   TURN      seconds of load in a turn
#   PADS_P_<W>  the pad of side A's placement i of workload W (bytes): base's in an A/A; in a
#             change comparison the pad of both base and head
#   PADS_Q_<W>  the pad of base's B side in an A/A of workload W
#   SEED_<W>  the seed of the order each workload's placements run in (schedule.mjs)
#   PLACEMENT_TIMEOUT  seconds a placement may take before it is stopped and counted failed; no
#             placement is run again, and a failed one leaves its comparison with no bound
#   WIN_WORKLOAD  the workload a CPU-cost reduction is declared for: none
# A pad of n bytes is one never-called function of n bytes linked first in .text (build.sh), so
# every function after it moves by n and keeps its order. The change's margin is +1% for every
# workload but BESIDE and BESIDEMT, whose is +5% (report.mjs); an A/A resolves at +1% for all.
KIT=cycles-deadline-2029-3
PART=gated
K_PLAIN=30
K_WAIT=69
K_CLOSE=30
K_UNSTAGED=53
K_AFTER=30
K_BESIDE=30
K_BESIDEMT=30
R=8
TURN=3
SEED_PLAIN=7411
SEED_WAIT=7412
SEED_CLOSE=7413
SEED_UNSTAGED=7414
SEED_AFTER=7415
SEED_BESIDE=7416
SEED_BESIDEMT=7417
PLACEMENT_TIMEOUT=300
WIN_WORKLOAD=none
PADS_P_PLAIN="320 15120 25824 40624 10304 21008 35808 5552 20288 30992 736 15536 26176 36880 10720 21424 36160 5904 16608 31408 1088 15888 26592 37296 11072 21776 36576 6320 16960 31760"
