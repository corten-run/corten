{
  "components": {
    "responses": {
      "Failure": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "A failure, as Problem Details (RFC 9457)"
      }
    },
    "schemas": {
      "AlertSet": {
        "properties": {
          "message": {
            "type": "string"
          },
          "partner": {
            "description": "The partner the alert was set for, when a partner set it; agents do not have one.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      },
      "Category": {
        "properties": {
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "slug"
        ],
        "type": "object"
      },
      "ContentLine": {
        "properties": {
          "id": {
            "type": "string"
          },
          "item_id": {
            "type": "string"
          },
          "quantity": {
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "item_id",
          "title",
          "quantity"
        ],
        "type": "object"
      },
      "CreateAlert": {
        "description": "A price alert as an agent or a partner asks for it: the form's fields (same names, same\nrules) plus the item.",
        "properties": {
          "email": {
            "description": "The email address to send the alert to.",
            "type": "string"
          },
          "id": {
            "description": "Item id, like item_17.",
            "type": "string"
          },
          "target_price": {
            "description": "Decimal dollars, like 4.50.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "target_price"
        ],
        "type": "object"
      },
      "Field": {
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "value"
        ],
        "type": "object"
      },
      "ItemView": {
        "properties": {
          "badges": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "categories": {
            "items": {
              "$ref": "#/components/schemas/Category"
            },
            "type": "array"
          },
          "contents": {
            "items": {
              "$ref": "#/components/schemas/ContentLine"
            },
            "type": "array"
          },
          "description": {
            "type": "string"
          },
          "fields": {
            "items": {
              "$ref": "#/components/schemas/Field"
            },
            "type": "array"
          },
          "id": {
            "type": "string"
          },
          "images": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "included_in": {
            "items": {
              "$ref": "#/components/schemas/ContentLine"
            },
            "type": "array"
          },
          "listings": {
            "items": {
              "$ref": "#/components/schemas/Listing"
            },
            "type": "array"
          },
          "offers": {
            "items": {
              "$ref": "#/components/schemas/Offer"
            },
            "type": "array"
          },
          "subtitle": {
            "type": [
              "string",
              "null"
            ]
          },
          "summary": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Summary"
              },
              {
                "type": "null"
              }
            ]
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "subtitle",
          "description",
          "badges",
          "tags",
          "categories",
          "fields",
          "images",
          "summary",
          "listings",
          "offers",
          "contents",
          "included_in"
        ],
        "type": "object"
      },
      "Listing": {
        "properties": {
          "condition": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "price": {
            "type": "string"
          },
          "price_value": {
            "format": "double",
            "type": "number"
          },
          "quantity": {
            "format": "int64",
            "type": "integer"
          },
          "rating": {
            "type": [
              "string",
              "null"
            ]
          },
          "reviews": {
            "format": "int64",
            "type": "integer"
          },
          "seller": {
            "type": "string"
          },
          "ships_from": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "seller",
          "rating",
          "reviews",
          "condition",
          "ships_from",
          "quantity",
          "price",
          "price_value"
        ],
        "type": "object"
      },
      "Offer": {
        "properties": {
          "buyer": {
            "type": "string"
          },
          "condition": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "price": {
            "type": "string"
          },
          "quantity": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "buyer",
          "condition",
          "quantity",
          "price"
        ],
        "type": "object"
      },
      "Problem": {
        "description": "A failure, as Problem Details (RFC 9457)",
        "properties": {
          "detail": {
            "type": "string"
          },
          "fields": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "form": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "format": "uri-reference",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "Summary": {
        "properties": {
          "count": {
            "format": "int64",
            "type": "integer"
          },
          "lowest": {
            "type": [
              "string",
              "null"
            ]
          },
          "quantity": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "lowest",
          "count",
          "quantity"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "card-market",
    "version": "0.1.0"
  },
  "openapi": "3.1.1",
  "paths": {
    "/api/alerts": {
      "post": {
        "operationId": "alert_json",
        "parameters": [
          {
            "description": "The partner's API key.",
            "in": "header",
            "name": "x-api-key",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAlert"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlertSet"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "$ref": "#/components/responses/Failure"
          }
        },
        "summary": "A price alert a partner's service sets for one of its users. The handler takes `Caller<Partner>`: a request without a known API key is a JSON 401."
      }
    },
    "/api/items/{id}": {
      "get": {
        "operationId": "item_json",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemView"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "$ref": "#/components/responses/Failure"
          }
        },
        "summary": "An item as JSON (the same data the page shows)."
      }
    }
  }
}
