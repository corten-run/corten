/* corten ui {{version}}: icon */
/* An <svg> at the text's size, its lines drawn in the text's color as Lucide draws them. */
.icon {
  flex: none; width: 1em; height: 1em; vertical-align: -.125em;
  fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round;
}
