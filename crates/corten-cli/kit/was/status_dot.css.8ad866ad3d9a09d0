/* corten ui {{version}}: status_dot */
.dot { display: inline-block; flex: none; width: .5rem; height: .5rem; border-radius: 50%; background: var(--kit-tone); }
.neutral { --kit-tone: var(--muted-foreground); }
.info { --kit-tone: var(--info); }
.success { --kit-tone: var(--success); }
.warning { --kit-tone: var(--warning); }
.destructive { --kit-tone: var(--destructive); }
/* LiveDot: its opacity pulses while the <corten-live> around it is live, and always outside one;
   never for a user who asks for less motion. */
@media (prefers-reduced-motion: no-preference) {
  .live { animation: status-dot-live 2s ease-in-out infinite; }
  :where(corten-live:not([status="live"])) .live { animation: none; }
}
@keyframes status-dot-live { 50% { opacity: .35; } }
/* A contrast theme paints a background as Canvas, which would leave a gap: the dot is drawn in the
   system's text color, and its tone is not shown, so the text beside it says the status. A live
   dot is still there too. */
@media (forced-colors: active) { .dot { forced-color-adjust: none; background: CanvasText; } .live { animation: none; } }
