/* corten ui {{version}}: radio_group */
.group { display: grid; gap: var(--choice-list-gap); margin: 0; padding: 0; border: 0; min-width: 0; }
.group > legend { margin-bottom: var(--choice-list-legend-gap); padding: 0; font-size: .875rem; font-weight: 500; }
/* The label is the whole target: its block padding is what one line leaves of --control-height, so
   one line is a control's height (a 44 px touch target under a theme that sets it so), and the circle
   sits on the first line's middle when the label wraps. */
.radio { display: inline-flex; align-items: start; gap: .5rem; padding-block: max(0px, (var(--control-height) - 1.25rem) / 2); font-size: .875rem; line-height: 1.25rem; cursor: pointer; }
.radio > input {
  appearance: none; flex: none; display: grid; place-content: center; margin: .125rem 0;
  width: 1rem; height: 1rem; border: 1px solid var(--input); border-radius: 50%;
  background: var(--background); cursor: inherit;
}
.radio > input::before { content: ""; width: .5rem; height: .5rem; border-radius: 50%; background: var(--primary); transform: scale(0); transition: transform .1s; }
.radio > input:checked { border-color: var(--primary); }
.radio > input:checked::before { transform: scale(1); }
.radio > input:focus-visible { outline: 2px solid var(--ring); outline-offset: 2px; }
.radio:has(> input:disabled) { opacity: .5; cursor: not-allowed; }
/* A contrast theme paints every background as Canvas, so a chosen radio's dot would vanish: it is
   drawn in the selection color, a disabled one in gray. */
@media (forced-colors: active) {
  .radio > input:checked { border-color: Highlight; }
  .radio > input::before { forced-color-adjust: none; background: Highlight; }
  .radio > input:disabled:checked { border-color: GrayText; }
  .radio > input:disabled::before { background: GrayText; }
}
