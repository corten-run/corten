/* corten ui {{version}}: steps */
.steps {
  display: flex; flex-wrap: wrap; align-items: center; gap: .5rem; margin: 0; padding: 0; list-style: none;
  counter-reset: kit-step; font-size: var(--control-font-size);
}
/* A step, then the line to the next, which grows to share the row; a row that wraps ends without one. */
.steps > li { display: flex; flex: 1 1 auto; align-items: center; gap: .5rem; counter-increment: kit-step; }
.steps > li:last-child { flex-grow: 0; }
.steps > li:not(:last-child)::after { content: ""; flex: 1 1 1rem; min-width: 1rem; height: 1px; background: var(--border); }
.steps > li > :is(a, span) {
  display: inline-flex; align-items: center; gap: .5rem; white-space: nowrap;
  color: var(--muted-foreground); text-decoration: none; border-radius: calc(var(--radius) - 2px);
}
.steps > li > :is(a, span)::before {
  content: counter(kit-step); display: inline-grid; place-items: center; flex: none; box-sizing: border-box;
  width: 1.75rem; height: 1.75rem; border: 1px solid var(--border); border-radius: 50%;
  background: var(--background); color: var(--foreground); font-size: .8125rem; font-weight: 500; font-variant-numeric: tabular-nums;
}
.steps > li > a { transition: color .15s; }
.steps > li > a:hover { color: var(--foreground); }
.steps > li > a:focus-visible { outline: 2px solid var(--ring); outline-offset: 2px; }
.steps [aria-current="step"] { color: var(--foreground); font-weight: 500; }
.steps [aria-current="step"]::before { border: 2px solid var(--primary); background: var(--primary); color: var(--primary-foreground); }
/* Every step before the current one is done: a check mark with no text for a screen reader, in
   place of its number, and the line after it filled. */
.steps > li:has(~ li > [aria-current="step"]) > :is(a, span) { color: var(--foreground); }
.steps > li:has(~ li > [aria-current="step"]) > :is(a, span)::before {
  content: "\2713" / ""; border-color: var(--success); background: var(--success); color: var(--success-foreground);
}
.steps > li:has(~ li > [aria-current="step"])::after { background: var(--success); }
.status { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
