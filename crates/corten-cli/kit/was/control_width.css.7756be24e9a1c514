/* corten ui {{version}}: control_width */
/* A control's width, from the theme's sizes, never wider than its container. Its max-width is the
   same, so a control a Field grows to fill its row stops at it. */
.control-width { box-sizing: border-box; }
.sm { width: min(var(--control-width-sm), 100%); max-width: min(var(--control-width-sm), 100%); }
.md { width: min(var(--control-width-md), 100%); max-width: min(var(--control-width-md), 100%); }
.lg { width: min(var(--control-width-lg), 100%); max-width: min(var(--control-width-lg), 100%); }
.full { width: 100%; }
