+/// The page after a wait of 1 ms: the handler is pending once, so its deadline's timer is in use.
+async fn wait(req: Req) -> HtmlResult {
+    tokio::time::sleep(std::time::Duration::from_millis(1)).await;
+    req.page(document())
+}
+
+async fn unstaged() -> &'static str {
+    "ok"
+}
+
 async fn sum(Params(at): Params<api::Sum>) -> String {
     (at.a.unwrap_or(0) + at.b.unwrap_or(0)).to_string()
 }
