# plan.env: the plan plan.md declares (kit 1999, corten-run/corten#1996 and #1999), read by plan.sh
# (build.sh, verify.sh, run.sh), report.mjs and check-report.mjs. Written before any measurement
# (amended after review 1, still before any measurement: plan.md, "Amendment 1"); pads.mjs --check
# holds PADS_P and PADS_Q to its lists for K_A and the rule.
#   KIT     this kit's name, written into every placement's record; report.mjs refuses others
#   K_A     part A: placements of aa-old, base-p<p_i> against base-p<q_i>, i = 1..K_A
#   K_B     part B: placements of same-old, base-p<p_i> against itself, i = 1..K_B. 0 in this plan:
#           B was cut for time (plan.md, "Time"); K_B=30 restores it, about 51 minutes more
#   K_C     part C: placements of each unpadded comparison, i = 1..K_C (pads p_1..p_K_C):
#           unpadded-base (base against base-p<p_i>), unpadded-head (head against head-p<p_i>),
#           unpadded-x1 (x1 against base-p<p_i>) and unpadded-x2 (x2 against base-p<p_i>)
#   R       recorded pairs per placement of A and B, after one unrecorded pair
#   R_C     the same for C
#   TURN    seconds of load in a turn
#   PADS_P  p_i, bytes (pads.mjs's P for K_A; its first 30 are the first two runs' PADS_P)
#   PADS_Q  q_i, bytes (pads.mjs's Q for K_A; its first 30 are the first two runs' PADS_Q)
#   STEP    seconds the workload old moves a start's monotonic clock on, once its answer is kept
#   OLD_LOW, OLD_HIGH  the Age a start of old must send, before and after its turn
#   YOUNG_LOW, YOUNG_HIGH  run-pair-old.sh's range for young, which this plan does not run
#   SCHEDULE_SEED  the seed of the random order aa-old's (and same-old's) placements run in
#           (schedule.mjs; plan.md, "Amendment 1")
#   PLACEMENT_TIMEOUT  seconds a placement may take before it is stopped and counted failed
#   RETRY_MAX  at most this many failed placements are rerun, once each, after the schedule
#   INSTR_NEAR  part C: an unpadded build of another commit is read as compiling old's path
#           nearly as base does when its placements' median change in user instructions a request
#           against base's padded builds is within this many percent either way
KIT=cycles-1996-1999
K_A=100
K_B=0
K_C=8
R=8
R_C=8
TURN=3
PADS_P="320 15120 25824 40624 10304 21008 35808 5552 20288 30992 736 15536 26176 36880 10720 21424 36160 5904 16608 31408 1088 15888 26592 37296 11072 21776 36576 6320 16960 31760 1504 16304 26944 37648 11488 22192 32832 6672 17376 32176 1856 12560 27360 38064 11840 22544 33248 7088 17728 32528 2272 12976 27712 38416 12256 22960 33600 7440 18144 28848 2624 13328 28128 38832 8512 23312 34016 7856 18496 29200 3040 13744 28480 39184 8928 23728 34368 4112 18912 29616 3392 14096 24800 39600 9280 24080 34784 4528 19264 29968 3808 14512 25152 39952 9696 24496 35136 4880 19680 30384"
PADS_Q="22848 12160 38336 27648 12880 2192 32464 17680 7008 33184 22496 11808 38000 27312 12528 1840 32064 17280 6592 32768 22096 11408 37584 26896 16224 1440 31712 16928 6256 36528 20528 12080 39424 27008 14400 832 33296 16656 7248 35664 23072 9504 37920 25440 12848 3376 31856 19312 5696 34240 21632 16256 40592 27984 14480 1936 30304 16736 4192 36768 23152 10608 39088 25520 12928 512 28864 19392 6864 35216 21712 9168 37536 28064 15520 7136 34480 17840 5360 36848 24256 15936 39168 26688 18192 1488 28944 16400 7904 35296 22752 10272 37616 25072 12592 3120 31488 19072 5440 33920"
STEP=10005
OLD_LOW=10005
OLD_HIGH=10020
YOUNG_LOW=0
YOUNG_HIGH=15
INSTR_NEAR=0.5
SCHEDULE_SEED=1996
PLACEMENT_TIMEOUT=300
RETRY_MAX=3
